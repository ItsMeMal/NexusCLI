{
  "name": "@mallssz/nexuscode-cli",
  "version": "0.1.6",
  "type": "module",
  "description": "NexusCode — a general-purpose AI orchestration CLI with dynamic providers, MCP, tools and specialist agents",
  "main": "src/cli.js",
  "bin": {
    "nexuscode": "src/cli.js"
  },
  "files": [
    "src/",
    "schemas/",
    "examples/",
    "agent.config.json",
    "README.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "server": "node src/server.js",
    "test": "node --test test/*.test.js",
    "tui": "node src/tui.js",
    "eval": "node evals/eval_runner.js",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ink": "^8.0.0",
    "node-fetch": "^3.3.2",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMeMal/NexusCode.git"
  },
  "homepage": "https://github.com/ItsMeMal/NexusCode#readme",
  "bugs": {
    "url": "https://github.com/ItsMeMal/NexusCode/issues"
  },
  "license": "MIT",
  "keywords": [
    "nexuscode",
    "ai",
    "cli",
    "agent",
    "llm",
    "mcp",
    "terminal"
  ],
  "publishConfig": {
    "access": "public"
  }
}
